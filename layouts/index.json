{{- $posts := where site.RegularPages "Section" "posts" -}}
[
{{- range $index, $post := $posts -}}
{{- if $index }},{{ end -}}
{
  "title": {{ $post.Title | jsonify }},
  "url": {{ $post.RelPermalink | jsonify }},
  "summary": {{ $post.Summary | plainify | htmlUnescape | jsonify }},
  "content": {{ $post.Content | plainify | htmlUnescape | jsonify }},
  "date": {{ $post.Date.Format "2006-01-02" | jsonify }},
  "tags": {{ $post.Params.tags | jsonify }},
  "categories": {{ $post.Params.categories | jsonify }}
}
{{- end -}}
]